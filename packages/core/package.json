{
  "name": "@bgunnarsson/binbook-core",
  "version": "0.1.0",
  "description": "binbook core — story discovery, arg resolution, the dev server, and the `binbook` CLI.",
  "license": "MIT",
  "author": "bgunnarsson <dentadesign@gmail.com>",
  "homepage": "https://github.com/bgunnarsson/binbook#readme",
  "bugs": "https://github.com/bgunnarsson/binbook/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bgunnarsson/binbook.git",
    "directory": "packages/core"
  },
  "keywords": [
    "binbook",
    "components",
    "storybook",
    "workshop",
    "design-system",
    "vite"
  ],
  "type": "module",
  "bin": {
    "binbook": "./bin/binbook.mjs"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "bin",
    "!**/*.test.ts",
    "!**/*.test.tsx",
    "!**/test-setup.ts"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.68.0",
    "@bgunnarsson/binbook-types": "workspace:*",
    "@bgunnarsson/binbook-viewer": "workspace:*",
    "fast-glob": "3.3.3",
    "minimatch": "10.2.5",
    "tsx": "4.23.1",
    "vite": "5.4.21",
    "ws": "8.21.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@bgunnarsson/binbook-adapter-html": "workspace:*",
    "@types/ws": "8.18.1"
  }
}
