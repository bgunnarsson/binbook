{
  "name": "@bgunnarsson/binbook-adapter-web-components",
  "version": "0.1.0",
  "description": "binbook Web Components adapter — renders custom elements (vanilla or Lit) live in the sandboxed canvas.",
  "license": "Apache-2.0",
  "author": "bgunnarsson <dentadesign@gmail.com>",
  "homepage": "https://github.com/bgunnarsson/binbook#readme",
  "bugs": "https://github.com/bgunnarsson/binbook/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bgunnarsson/binbook.git",
    "directory": "packages/adapter-web-components"
  },
  "keywords": [
    "binbook",
    "adapter",
    "web-components",
    "custom-elements",
    "lit",
    "workshop"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "NOTICE",
    "!**/*.test.ts",
    "!**/*.test.tsx",
    "!**/test-setup.ts"
  ],
  "scripts": {
    "prepack": "cp ../../NOTICE NOTICE",
    "postpack": "rm NOTICE"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@bgunnarsson/binbook-types": "workspace:*",
    "esbuild": "0.21.5"
  },
  "peerDependencies": {
    "lit": ">=3"
  },
  "peerDependenciesMeta": {
    "lit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@bgunnarsson/binbook-adapter-conformance": "workspace:*"
  }
}
