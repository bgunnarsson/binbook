<?xml version="1.0" encoding="utf-8"?>
<!--
  Scoped feed config so `dotnet build` restores packages from nuget.org even
  when a machine-wide config points at a private (auth-gated) feed. `<clear />`
  drops inherited sources for this project tree only.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
