<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Binbook.RazorHost</RootNamespace>
    <AssemblyName>RazorHost</AssemblyName>
    <!-- Required so runtime Razor compilation can resolve metadata references. -->
    <PreserveCompilationContext>true</PreserveCompilationContext>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <!-- The real ASP.NET Core MVC Razor view engine + runtime compilation, so
         Tag Helpers, layouts, partials, and view components all render. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="8.0.*" />
  </ItemGroup>
</Project>
