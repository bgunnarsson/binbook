{
  "name": "@bgunnarsson/binbook-adapter-umbraco",
  "version": "2.0.0",
  "description": "binbook Umbraco adapter — renders Umbraco partials and Block List blocks against a live site, plus offline .NET Razor via a host bridge.",
  "license": "SEE LICENSE IN LICENSE",
  "author": "bgunnarsson <dentadesign@gmail.com>",
  "homepage": "https://github.com/bgunnarsson/binbook#readme",
  "bugs": "https://github.com/bgunnarsson/binbook/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bgunnarsson/binbook.git",
    "directory": "packages/adapter-umbraco"
  },
  "keywords": [
    "binbook",
    "adapter",
    "umbraco",
    "razor",
    "dotnet",
    "components",
    "workshop"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "host",
    "LICENSE",
    "!host/bin",
    "!host/obj",
    "!**/*.test.ts",
    "!**/*.test.tsx",
    "!**/test-setup.ts"
  ],
  "scripts": {
    "prepack": "cp ../../LICENSE LICENSE",
    "postpack": "rm LICENSE"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@bgunnarsson/binbook-types": "workspace:*"
  },
  "devDependencies": {
    "@bgunnarsson/binbook-adapter-conformance": "workspace:*"
  }
}
