{
  "$schema": "https://biomejs.dev/schemas/2.3.9/schema.json",
  "root": true,
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/build",
      "!**/out",
      "!**/coverage",
      "!**/test-results",
      "!**/playwright-report",
      "!**/.next",
      "!**/target",
      "!**/*.tsbuildinfo",
      "!**/*.min.js",
      "!**/pnpm-lock.yaml",
      "!**/package-lock.json",
      "!biome.json",
      "!**/examples/html-sandbox/src",
      "!**/test/fixtures"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "style": {
        "useBlockStatements": "error"
      },
      "suspicious": {
        "noArrayIndexKey": "off",
        "noAsyncPromiseExecutor": "error",
        "noCatchAssign": "error",
        "noCommentText": "error",
        "noCompareNegZero": "error",
        "noDebugger": "warn",
        "noDoubleEquals": "error",
        "noDuplicateParameters": "error",
        "noExplicitAny": "error",
        "noFunctionAssign": "error",
        "noImportAssign": "error",
        "noLabelVar": "error",
        "noShadowRestrictedNames": "error",
        "noSparseArray": "error",
        "noUnsafeNegation": "error",
        "noRedeclare": "error",
        "noTsIgnore": "error",
        "useIterableCallbackReturn": "off",
        "noPrototypeBuiltins": "off",
        "useBiomeIgnoreFolder": "off",
        "noUnknownAtRules": "off"
      },
      "complexity": {
        "noExtraBooleanCast": "error",
        "noImportantStyles": "off"
      },
      "correctness": {
        "noChildrenProp": "error",
        "noUnreachable": "error"
      },
      "performance": {
        "noDelete": "error"
      },
      "a11y": {
        "noAutofocus": "error",
        "noPositiveTabindex": "error",
        "useAltText": "error",
        "useAnchorContent": "error",
        "useButtonType": "error",
        "useKeyWithClickEvents": "warn",
        "useKeyWithMouseEvents": "off",
        "useValidAnchor": "error"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "semicolons": "asNeeded",
      "trailingCommas": "es5",
      "quoteStyle": "single"
    }
  },
  "overrides": [
    {
      "includes": ["**/*.svelte", "**/*.vue", "**/*.astro"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedImports": "off"
          },
          "style": {
            "useConst": "off"
          }
        }
      }
    }
  ]
}
