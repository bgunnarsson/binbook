<div class="counter">
  <button class="btn btn--primary btn--md" data-dec aria-label="decrement">−</button>
  <output class="counter__value" aria-label="count"><span>{{label}}</span>: <span data-n>0</span></output>
  <button class="btn btn--primary btn--md" data-inc aria-label="increment">+</button>
</div>
<script>
  (function () {
    var count = Number("{{start}}") || 0;
    var step = Number("{{step}}") || 1;
    var n = document.querySelector("[data-n]");
    n.textContent = count;
    document.querySelector("[data-inc]").addEventListener("click", function () { n.textContent = count += step; });
    document.querySelector("[data-dec]").addEventListener("click", function () { n.textContent = count -= step; });
  })();
</script>
