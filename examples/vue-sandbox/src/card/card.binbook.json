{
  "title": "Components/Card",
  "description": "A simple content card (Vue SFC).",
  "component": "./Card.vue",
  "args": {
    "title": { "type": "text", "default": "Card title" },
    "body": { "type": "text", "default": "Card body text." },
    "variant": { "type": "select", "options": ["default", "elevated", "outlined"], "default": "default" }
  },
  "stories": [
    { "name": "Default", "args": {} },
    { "name": "Elevated", "args": { "variant": "elevated", "title": "Elevated card" } },
    { "name": "Outlined", "args": { "variant": "outlined", "title": "Outlined card" } }
  ]
}
